generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// A subscription tier the super developer defines and assigns to
// organizations, capping which gateable features (see src/lib/features.ts)
// that org's users can reach. `features` is a JSON array of feature keys —
// stored as free-form JSON rather than one column per feature so the super
// developer can add a new gateable feature in code without a schema
// migration; it only needs an entry in the FEATURES registry to show up as
// a togglable checkbox here.
model Package {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  features     String   @default("[]")
  studentLimit Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Pricing is descriptive, not transactional — nothing charges a card here.
  // The super developer records money actually received as Payment rows and
  // extends the org's accessExpiresAt by hand; price/billingCycle exist so
  // the public pricing page and the renewal maths have a figure to work from.
  price        Float?
  currency     String   @default("CNY")
  billingCycle String   @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY | ONE_TIME
  // Only packages marked public appear on the marketing site's pricing table;
  // bespoke or legacy tiers stay internal.
  isPublic     Boolean  @default(false)
  // The tier a self-serve trial signup lands on. Exactly one package should
  // carry this; the trial route picks the lowest sortOrder among any that do.
  isTrialPlan  Boolean  @default(false)

  organizations Organization[]
}

// Money actually received, logged by hand by the super developer. Immutable
// history: renewing an org appends a row and pushes accessExpiresAt out,
// rather than overwriting anything, so the billing trail survives plan
// changes. Cascade — a deleted org's payment history goes with it.
model Payment {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String   @default("CNY")
  method         String?  // BANK_TRANSFER | ALIPAY | WECHAT | CASH | OTHER
  reference      String?
  note           String?
  // The access window this payment bought — periodEnd is what gets written
  // to the organization's accessExpiresAt when the payment is recorded.
  periodStart    DateTime
  periodEnd      DateTime
  recordedById   String
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// A prospect the super developer added by hand (or pasted in bulk) for
// outreach. Deliberately separate from User: these people have no account,
// no organization and no login — they are people to sell to, not people
// using the product. Campaign recipients can be drawn from either source.
model Lead {
  id               String   @id @default(uuid())
  name             String
  // Lowercased on write so the same address can't be added twice with
  // different capitalisation and then emailed twice.
  email            String   @unique
  organizationName String?
  phone            String?
  country          String?
  website          String?
  notes            String?
  // MANUAL | IMPORT — where the row came from, so a bulk paste can be
  // distinguished from a deliberate single add later.
  source           String   @default("MANUAL")
  // Honours the same unsubscribe link as account holders; the public
  // unsubscribe route sets this alongside User.marketingOptOut.
  marketingOptOut  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  suspendedAt     DateTime?
  suspendedReason String?
  planTier        String    @default("TRIAL")
  studentLimit    Int?
  inviteCode      String    @unique @default(uuid())
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // No package assigned = unrestricted (every gateable feature available) —
  // legacy orgs and anyone the super developer hasn't put on a tier yet keep
  // full access instead of silently losing features on deploy. SetNull (not
  // Cascade or Restrict): deleting a package shouldn't take its orgs down,
  // it should just uncap them back to unrestricted.
  packageId String?
  package   Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Null = never expires (the pre-existing orgs, and anything the super
  // developer runs open-ended). A date in the past locks every one of that
  // org's users out exactly like SUSPENDED does — see getEffectiveUser.
  accessExpiresAt DateTime?
  // Set by the public 7-day trial signup, cleared on first real payment.
  // Purely for labelling: expiry itself is always accessExpiresAt.
  isTrial         Boolean   @default(false)
  // Where this company's own alert mail goes. Falls back to the OWNER's
  // login address when unset — the developer inbox is never a default for
  // org-scoped mail, only a last resort when an org has no owner at all.
  alertEmail      String?

  // Lifecycle mail bookkeeping. The two expiry fields store the
  // accessExpiresAt value each notice was sent *for*, rather than a plain
  // "sent" boolean: renewing moves accessExpiresAt, which no longer matches
  // the stored value, so the next cycle's reminder fires again on its own
  // with nothing to reset by hand.
  welcomeSentAt              DateTime?
  reminderSentForExpiry      DateTime?
  expiredNoticeSentForExpiry DateTime?

  payments Payment[]

  users                User[]
  students             Student[]
  documents            Document[]
  transactions         Transaction[]
  messages             Message[]
  universityPortals    UniversityPortal[]
  offers               Offer[]
  documentRequirements DocumentRequirement[]
  fieldRequirements    FieldRequirement[]
  scanSettings         ScanSettings[]
  activityLogs         ActivityLog[]
  organizationProfiles OrganizationProfile[]
  tasks                Task[]
  universities         University[]
  universityDocuments  UniversityDocument[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  role        String   @default("AGENT")
  isActive    Boolean  @default(true)
  phone       String?
  wechat      String?
  avatar      String?
  bio         String?
  timezone    String?
  canViewPortals Boolean @default(false)
  receiveAlerts  Boolean @default(false)
  canExportBackup Boolean @default(false)
  canManageOfficialDocuments Boolean @default(false)
  marketingOptOut Boolean @default(false)
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  pendingEmail              String?
  pendingEmailTokenHash     String?
  pendingEmailTokenExpiresAt DateTime?
  studentIntakeCode String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managedByAdminId String?
  managedByAdmin    User?   @relation("AdminManagesAgents", fields: [managedByAdminId], references: [id])
  managedAgents     User[]  @relation("AdminManagesAgents")

  // Nullable for now during the multi-tenant migration — every role except
  // SUPER_DEVELOPER will require one once backfilled (see Milestone 1 plan).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  students        Student[]
  uploadedDocs    Document[]      @relation("UploadedBy")
  uploadedUniversityDocs UniversityDocument[] @relation("UniversityDocUploadedBy")
  createdUniversities    University[]
  activityLogs    ActivityLog[]
  sentMessages    Message[]       @relation("SentBy")
  receivedMessages Message[]      @relation("ReceivedBy")
  organizationProfile OrganizationProfile?
  transactions      Transaction[] @relation("AgentTransactions")
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
  universityPortals UniversityPortal[]
  offers            Offer[]
  createdTasks      Task[] @relation("TaskCreatedBy")
  assignedTasks     Task[] @relation("TaskAssignedTo")
  campaigns         Campaign[]
  createdResources        PlatformResource[]
  resourceGrantsReceived  ResourceGrant[]      @relation("ResourceGrantedTo")
  resourceGrantsIssued    ResourceGrant[]      @relation("ResourceGrantedBy")
  resourceAccessLogs      ResourceAccessLog[]  @relation("ResourceAccessedBy")
}

model Student {
  id                        String   @id @default(uuid())
  serialNumber              String?
  
  // Personal Information
  passportFamilyName        String
  givenName                 String
  fullName                  String
  photo                     String?
  gender                    String
  chineseName               String?
  maritalStatus             String
  religion                  String
  occupation                String
  employerInstitution       String?
  nationality               String
  dateOfBirth               String
  yearsInHomeCountry        String?
  countryOfBirth            String
  wechat                    String?
  placeOfBirth              String
  chineseDescent            String   @default("No")
  currentlyInChina          String   @default("No")
  
  // Correspondence Address
  homeAddress               String?
  detailedAddress           String
  cityProvince              String
  country                   String
  zipcode                   String
  phoneMobile               String
  mainEmail                 String
  
  // Passport & Visa
  passportNo                String
  passportExpiryDate        String
  oldPassportNo             String?
  oldPassportExpiry         String?
  
  // China Study Experience
  studiedInChina            String   @default("No")
  visaType                  String?
  chinaInstitution          String?
  visaExpiryDate            String?
  studyInChinaFrom          String?
  studyInChinaTo            String?
  
  // Program applied for
  programApplied            String?
  totalFee                  Float?
  myCosting                 Float?

  status                    String   @default("PENDING")
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  agentId         String
  agent           User            @relation(fields: [agentId], references: [id])
  documents       Document[]
  educationHistory EducationHistory[]
  workExperience   WorkExperience[]
  familyMembers    FamilyMember[]
  financialSponsors FinancialSponsor[]
  messages         Message[]
  transactions     Transaction[]
  portalSnapshots  PortalStudentSnapshot[]
  universityDocuments UniversityDocument[]
  suggestedUniversityDocuments UniversityDocument[] @relation("UniversityDocSuggestedStudent")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
}

model EducationHistory {
  id           String   @id @default(uuid())
  degree       String
  schoolName   String
  yearFrom     String
  yearTo       String
  contactPerson String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id           String   @id @default(uuid())
  yearFrom     String
  yearTo       String
  company      String
  occupation   String
  reference    String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id           String   @id @default(uuid())
  name         String
  relationship String
  nationality  String
  employer     String?
  occupation   String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FinancialSponsor {
  id           String   @id @default(uuid())
  name         String
  relationship String
  nationality  String
  employer     String?
  occupation   String?
  phone        String?
  email        String?
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Document {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         String
  category     String   @default("OTHER")
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Message {
  id             String    @id @default(uuid())
  content        String    @default("")
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  senderId    String
  sender      User      @relation("SentBy", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ReceivedBy", fields: [receiverId], references: [id])
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model DocumentRequirement {
  id          String   @id @default(uuid())
  key         String
  label       String
  description String?
  accept      String   @default(".pdf,image/*")
  type        String   @default("PDF")
  maxSize     String?
  isRequired  Boolean  @default(false)
  isOfficial  Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}

model FieldRequirement {
  id          String   @id @default(uuid())
  key         String
  label       String
  section     String
  isRequired  Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}

model OrganizationProfile {
  id             String   @id @default(uuid())
  name           String
  logo           String?
  email          String?
  phone          String?
  wechat         String?
  address        String?
  website        String?
  description    String?
  welcomeMessage String?
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  type            String   // INCOME | EXPENSE
  category        String
  amount          Float
  currency        String   @default("CNY")
  paymentMethod   String?
  status          String   @default("COMPLETED") // COMPLETED | PENDING | REFUNDED
  description     String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  agentId         String
  agent           User     @relation("AgentTransactions", fields: [agentId], references: [id])

  createdById     String
  createdBy       User     @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([agentId])
  @@index([studentId])
  @@index([organizationId])
}

// A catalog of partner universities — distinct from UniversityPortal (which
// holds login credentials for scraping an external application portal).
// This is admin/owner-only reference filing: per-university admission
// letters and JW forms actually issued, archived independent of any one
// student.
model University {
  id        String   @id @default(uuid())
  name      String
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  documents UniversityDocument[]

  @@index([organizationId])
}

model UniversityDocument {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  category     String   @default("OTHER") // ADMISSION_LETTER | JW | OTHER
  createdAt    DateTime @default(now())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("UniversityDocUploadedBy", fields: [uploadedById], references: [id])

  // Optional — these are filed per-university, but each admission letter/JW
  // is usually issued for one real student. Tagging it lets a search by
  // student name or passport number find it without knowing which
  // university's page it was filed under. SetNull (not Cascade): deleting
  // the student record shouldn't delete the historical document.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Background text-detection result for documents uploaded without a manual
  // student tag: PENDING while running, SUGGESTED once a confident candidate
  // is found (needs a human click to accept — never auto-applied), NO_MATCH,
  // UNSUPPORTED (no extractable text — e.g. a scanned image-only PDF with no
  // rasterization pipeline), FAILED, or SKIPPED (a student was already
  // tagged manually at upload, so detection never ran).
  ocrStatus            String   @default("SKIPPED")
  suggestedStudentId   String?
  suggestedStudent     Student? @relation("UniversityDocSuggestedStudent", fields: [suggestedStudentId], references: [id], onDelete: SetNull)
  suggestedMatchReason String? // "passport" | "name"

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([universityId])
  @@index([studentId])
  @@index([suggestedStudentId])
}

model UniversityPortal {
  id             String    @id @default(uuid())
  name           String
  loginUrl       String
  username       String
  passwordEnc    String
  platform       String    @default("AT0086")
  isActive       Boolean   @default(true)
  useProxy       Boolean   @default(false)
  lastScanAt     DateTime?
  lastScanStatus String?
  lastScanError  String?
  lastScanCount  Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  students PortalStudentSnapshot[]
  changes  PortalStatusChangeLog[]

  @@index([organizationId])
}

model PortalStudentSnapshot {
  id           String   @id @default(uuid())
  externalId   String
  passportNo   String?
  passportName String?
  program      String?
  applyStatus  String?
  admitStatus  String?
  appliedAt    DateTime?
  raw          String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portalId String
  portal   UniversityPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  matchedStudentId String?
  matchedStudent   Student? @relation(fields: [matchedStudentId], references: [id])

  @@unique([portalId, externalId])
  @@index([passportNo])
}

model PortalStatusChangeLog {
  id           String   @id @default(uuid())
  externalId   String
  passportName String?
  passportNo   String?
  field        String
  oldValue     String?
  newValue     String?
  detectedAt   DateTime @default(now())

  portalId String
  portal   UniversityPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
}

model ScanSettings {
  id                String    @id @default(uuid())
  intervalHours     Int       @default(5)
  enabled           Boolean   @default(true)
  lastRunAt         DateTime?
  // Portals are scanned one at a time, never in one batch — this marks when
  // the last individual portal scan kicked off, so the next one waits out
  // the stagger gap instead of firing immediately alongside it.
  lastPortalScanAt  DateTime?
  staggerMinutes    Int       @default(5)

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model VisitorLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  userEmail String?
  userRole  String?
  path      String
  referrer  String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  // Which tenant's analytics this hit belongs to. Null for genuinely
  // anonymous traffic (the marketing and login pages, where no org is
  // known yet) — those rows are visible only to the super developer, never
  // attributed to some arbitrary org. Rows written before this column
  // existed are also null, so they drop out of per-org views rather than
  // leaking across tenants.
  organizationId String?

  @@index([userId])
  @@index([createdAt])
  @@index([path])
  @@index([organizationId])
}

model Offer {
  id          String    @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([isActive])
  @@index([startDate])
  @@index([organizationId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Task {
  id                String    @id @default(uuid())
  title             String
  description       String?
  dueAt             DateTime
  status            String    @default("PENDING") // PENDING | COMPLETED
  completedAt       DateTime?
  // Set once an overdue email has gone out, so the deadline-check cron
  // never sends the same "not completed" notice twice for one task.
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignedToId String
  assignedTo   User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([dueAt])
}

// Platform-level marketing to the developer's own leads — every org owner
// and user who has ever signed up on this deployment. Not org-scoped:
// only SUPER_DEVELOPER can create/send these (see /api/platform/campaigns).
model Campaign {
  id          String   @id @default(uuid())
  subject     String
  body        String
  audience    String   @default("ALL") // ALL | OWNERS
  status      String   @default("SENDING") // SENDING | SENT | FAILED
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
  completedAt DateTime?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  recipients  CampaignRecipient[]
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  email      String
  name       String
  orgName    String?
  status     String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  error      String?
  sentAt     DateTime?

  // Open tracking via a 1x1 pixel. openCount can exceed 1 (re-opening, or a
  // client re-fetching images) so firstOpenedAt is kept separately rather
  // than being overwritten each time. Both stay null for anyone whose client
  // blocks images, which is common — see the tracking route for why these
  // numbers are a floor, never an exact readership figure.
  openedAt   DateTime?
  lastOpenedAt DateTime?
  openCount  Int       @default(0)

  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Platform-level shareable resource (a file or a link) the developer hands
// out to specific admins. Not org-scoped — same reasoning as Campaign.
model PlatformResource {
  id           String   @id @default(uuid())
  title        String
  description  String?
  kind         String   // FILE | LINK
  filename     String?  // set when kind = FILE; stored under storage/resources/, never public/
  originalName String?
  mimeType     String?
  size         Int?
  url          String?  // set when kind = LINK
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grants     ResourceGrant[]
  accessLogs ResourceAccessLog[]
}

// One admin's permission to see one resource. Deleting this row revokes
// access immediately; it does not touch that admin's past ResourceAccessLog
// rows, so history survives a later revoke.
model ResourceGrant {
  id          String   @id @default(uuid())
  resourceId  String
  resource    PlatformResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User     @relation("ResourceGrantedTo", fields: [adminId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("ResourceGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now())

  @@unique([resourceId, adminId])
  @@index([adminId])
}

// One row per open/download — full history, not deduped. Written only by
// GET /api/resources/[id]/open, the single route that ever serves the
// underlying file or link.
model ResourceAccessLog {
  id         String   @id @default(uuid())
  resourceId String
  resource   PlatformResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  adminId    String
  admin      User     @relation("ResourceAccessedBy", fields: [adminId], references: [id], onDelete: Cascade)
  accessedAt DateTime @default(now())

  @@index([resourceId])
  @@index([adminId])
}
