# Required — app refuses to start without this
NEXTAUTH_SECRET=

# Database (SQLite; matches prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# SMTP (163.com in production — see src/lib/email.ts)
EMAIL_USER=
EMAIL_PASS=

# Google Gemini API key, used by the marketing-site chatbot widget
GEMINI_API_KEY=

# Email address notified on developer-facing alerts
DEVELOPER_ALERT_EMAIL=

# Encrypts stored university-portal credentials at rest
PORTAL_ENCRYPTION_KEY=

# Optional outbound proxy for university-portal scraping
PORTAL_PROXY_URL=
PORTAL_PROXY_SECRET=

# Verbose portal-scraping logs when set
PORTAL_DEBUG=
